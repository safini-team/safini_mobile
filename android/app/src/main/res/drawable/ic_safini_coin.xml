<?xml version="1.0" encoding="utf-8"?>
<!-- The Safini Time Coin, the same drawing as DsCoinToken.svg in
     lib/core/utils/widgets/ds/ds_pill.dart: green ring, gold rim, orange inner
     ring, gold-to-orange face, white tick with a brown outline. Keep the two in
     step. -->
