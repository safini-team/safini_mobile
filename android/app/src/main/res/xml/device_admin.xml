<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately no policies. Being an active admin is all we need to stop a
     casual uninstall and to get onDisableRequested/onDisabled callbacks. We ask
     for no lock, wipe or password control, so the activation dialog stays honest
     and Play review has nothing invasive to weigh. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
