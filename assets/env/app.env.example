# Copy to project root as `.env` for local tooling only, or edit `app.env` for defaults.
# Never add the web client *secret* to Flutter — use it only in Supabase Dashboard
# (Authentication → Providers → Google) or server-side code.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=xxx.apps.googleusercontent.com

# Optional: for Supabase / scripts — do NOT bundle in the mobile or web app.
# GOOGLE_WEB_CLIENT_SECRET=GOCSPX-...
