<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the provisioning profile. Enable Family Controls on App ID
	     com.safini.app, then keep this key so the signed binary can talk to
	     the Screen Time helper. Mismatch either kills install or yields
	     "Couldn't communicate with a helper application". -->
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>
